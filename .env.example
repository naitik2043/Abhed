# Shared state (so the laptop and the judge's phone see the same world). Without these, state is in memory.
# Get these from https://supabase.com/dashboard -> your project -> Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_publishable_paste_your_key_here
# Server-only secret key: needed for shared state. Never expose this in browser code or commit its value.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_paste_your_key_here
# Optional stable signing secret for agent/admin keys and approver sessions.
KAVACH_AGENT_SECRET=generate_a_long_random_secret
# Optional: a real LLM plans the agents' tool calls (otherwise an offline instruction-follower does)
# Get from https://console.groq.com/keys
GROQ_API_KEY=gsk_paste_your_key_here
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=paste_your_key_here
# Optional: protect /api/command (demo director). Open the app once with ?key=<value> to store it.
DIRECTOR_KEY=
# --- Demo company websites on Render (sites/server.mjs + sites/zentro/server.mjs) ---
# KAVACH_URL=https://abhed.vercel.app
# SITE=novabank            # novabank | sanjeevani | bazaar  (zentro uses its own service)
# KAVACH_KEYS={"rex":"kv_live_paste_here"}
# KAVACH_ADMIN_KEY=paste_admin_key_here
# ADMIN_PIN=2468
# SITE_COOKIE_SECRET=paste_random_secret_here
